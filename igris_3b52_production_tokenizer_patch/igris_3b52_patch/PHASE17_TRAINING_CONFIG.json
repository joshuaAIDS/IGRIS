{
  "training_version": "v1.0.0-phase17-pretraining",
  "model_config": {
    "name": "igris-prod-16l",
    "vocab_size": 32768,
    "hidden_size": 512,
    "intermediate_size": 2048,
    "num_hidden_layers": 16,
    "num_attention_heads": 8,
    "num_key_value_heads": 4,
    "max_position_embeddings": 2048,
    "rms_norm_eps": 1e-05,
    "rope_theta": 10000.0,
    "tie_word_embeddings": false,
    "dropout": 0.0,
    "pad_token_id": 0,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "initializer_range": 0.02
  },
  "target_environment": "synthetic_test",
  "random_seed": 42,
  "batch_size": 2,
  "gradient_accumulation_steps": 2,
  "max_steps": 50,
  "eval_interval": 10,
  "checkpoint_interval": 10,
  "gradient_clipping": 1.0,
  "optimizer": {
    "name": "AdamW",
    "lr": 0.0005,
    "weight_decay": 0.01,
    "betas": [0.9, 0.95],
    "eps": 1e-08
  },
  "scheduler": {
    "name": "cosine",
    "warmup_steps": 5,
    "min_lr_ratio": 0.1
  },
  "mixed_precision": "no",
  "max_seq_len": 256,
  "save_top_k": 3,
  "owner_authorization_reference": "AUTH-SOLO-OWNER-PHASE17-PRETRAINING-VALIDATION",
  "output_checkpoint_dir": "experiments/phase17_experiments/checkpoints"
}
