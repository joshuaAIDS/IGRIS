{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IGRIS Transformer Model Configuration Schema",
  "description": "Validation schema for IGRIS decoder-only transformer hyperparameters, ensuring architectural invariants are preserved.",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "name",
    "vocab_size",
    "hidden_size",
    "intermediate_size",
    "num_hidden_layers",
    "num_attention_heads",
    "num_key_value_heads",
    "max_position_embeddings",
    "rms_norm_eps",
    "rope_theta",
    "tie_word_embeddings"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "vocab_size": {
      "type": "integer",
      "enum": [32768]
    },
    "hidden_size": {
      "type": "integer",
      "minimum": 64,
      "maximum": 4096
    },
    "intermediate_size": {
      "type": "integer",
      "minimum": 128,
      "maximum": 16384
    },
    "num_hidden_layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "num_attention_heads": {
      "type": "integer",
      "minimum": 1
    },
    "num_key_value_heads": {
      "type": "integer",
      "minimum": 1
    },
    "max_position_embeddings": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    },
    "rms_norm_eps": {
      "type": "number",
      "minimum": 1e-8,
      "maximum": 1e-3
    },
    "rope_theta": {
      "type": "number",
      "minimum": 1000.0
    },
    "tie_word_embeddings": {
      "type": "boolean"
    },
    "dropout": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.5
    },
    "pad_token_id": {
      "type": "integer",
      "enum": [0]
    },
    "bos_token_id": {
      "type": "integer",
      "enum": [1]
    },
    "eos_token_id": {
      "type": "integer",
      "enum": [2]
    },
    "gradient_checkpointing": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
